{
  "name": "valuation-radar",
  "version": "0.1.0",
  "description": "Local-first valuation research and ranking workspace",
  "license": "GPL-3.0-or-later",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "dev": "concurrently -k -n api,web,worker,scheduler -c blue,green,yellow,magenta \"pnpm dev:api\" \"pnpm dev:web\" \"pnpm dev:worker\" \"pnpm dev:scheduler\"",
    "dev:api": "node scripts/python.mjs -m uvicorn app.main:app --reload --app-dir apps/api --host 127.0.0.1 --port 8000",
    "dev:web": "pnpm --dir apps/web dev",
    "dev:worker": "node scripts/python.mjs -m app.worker worker",
    "dev:scheduler": "node scripts/python.mjs -m app.worker scheduler",
    "build": "pnpm --dir apps/web build",
    "typecheck": "pnpm typecheck:api && pnpm typecheck:web",
    "typecheck:api": "node scripts/python.mjs -m mypy --config-file apps/api/pyproject.toml apps/api/app",
    "typecheck:web": "pnpm --dir apps/web typecheck",
    "test": "pnpm test:api && pnpm test:web",
    "test:api": "node scripts/python.mjs --env PYTEST_DISABLE_PLUGIN_AUTOLOAD=1 -m pytest apps/api/tests",
    "test:web": "pnpm --dir apps/web test",
    "test:e2e": "pnpm --dir apps/web test:e2e",
    "lint": "pnpm lint:api && pnpm lint:web",
    "lint:api": "node scripts/python.mjs -m ruff check apps/api",
    "lint:web": "pnpm --dir apps/web lint",
    "db:migrate": "node scripts/python.mjs -m alembic -c apps/api/alembic.ini upgrade head",
    "import:legacy": "node scripts/python.mjs -m app.cli import-legacy --data-dir ../data"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
