{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valuation-radar.local/skills/value-investing/card-v1.2.schema.json",
  "title": "Valuation Radar value-investing card v1.2",
  "description": "Canonical structured valuation card shared by Codex output, backend import and Web rendering.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_date",
    "generated_at",
    "name",
    "codes",
    "asset_type",
    "path",
    "model_modules",
    "industry",
    "cycle_stage",
    "cycle_position",
    "quality",
    "conclusion",
    "macro",
    "markets",
    "risks",
    "missing",
    "notes",
    "presentation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.2"
    },
    "analysis_date": {
      "type": "string",
      "format": "date"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "codes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^(A|H|US|CN)$": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "asset_type": {
      "enum": [
        "stock",
        "etf"
      ]
    },
    "path": {
      "$ref": "#/$defs/valuationPath"
    },
    "model_modules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/modelModule"
      }
    },
    "industry": {
      "type": "string",
      "minLength": 1
    },
    "cycle_stage": {
      "$ref": "#/$defs/lifecycleStage"
    },
    "cycle_position": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "quality": {
      "$ref": "#/$defs/quality"
    },
    "conclusion": {
      "$ref": "#/$defs/conclusion"
    },
    "macro": {
      "$ref": "#/$defs/macro"
    },
    "markets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/market"
      }
    },
    "risks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "missing": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "string"
      },
      "description": "New v1.2 cards must be complete. Missing required data must reject the card instead of being recorded."
    },
    "notes": {
      "type": "string"
    },
    "presentation": {
      "$ref": "#/$defs/presentation"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "path": {
            "const": "stable"
          }
        },
        "required": [
          "path"
        ]
      },
      "then": {
        "properties": {
          "model_modules": {
            "items": {
              "enum": [
                "gordon_reverse",
                "peg",
                "dividend_sustainability",
                "dividend_yield"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "path": {
            "const": "cyclical"
          }
        },
        "required": [
          "path"
        ]
      },
      "then": {
        "properties": {
          "model_modules": {
            "items": {
              "enum": [
                "normalized_earnings",
                "cycle_position",
                "pb_roe"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "path": {
            "const": "financial"
          }
        },
        "required": [
          "path"
        ]
      },
      "then": {
        "properties": {
          "model_modules": {
            "items": {
              "enum": [
                "pb_roe",
                "pev_sensitivity",
                "nbv_quality",
                "solvency"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "path": {
            "const": "etf"
          }
        },
        "required": [
          "path"
        ]
      },
      "then": {
        "properties": {
          "asset_type": {
            "const": "etf"
          },
          "markets": {
            "items": {
              "required": [
                "etf_metrics"
              ]
            }
          },
          "model_modules": {
            "items": {
              "enum": [
                "index_percentile",
                "tracking_quality",
                "dividend_yield"
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "asset_type": {
            "const": "stock"
          }
        }
      }
    }
  ],
  "$defs": {
    "valuationPath": {
      "enum": [
        "stable",
        "cyclical",
        "financial",
        "etf"
      ]
    },
    "modelModule": {
      "enum": [
        "gordon_reverse",
        "peg",
        "dividend_sustainability",
        "normalized_earnings",
        "cycle_position",
        "pb_roe",
        "pev_sensitivity",
        "nbv_quality",
        "solvency",
        "index_percentile",
        "tracking_quality",
        "dividend_yield"
      ]
    },
    "marketCode": {
      "enum": [
        "A",
        "H",
        "US",
        "CN"
      ]
    },
    "currency": {
      "enum": [
        "CNY",
        "HKD",
        "USD"
      ]
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "label"
      ],
      "properties": {
        "code": {
          "enum": [
            "buy",
            "accumulate",
            "watch",
            "hold",
            "reduce",
            "avoid",
            "excluded",
            "not_applicable"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "label"
      ],
      "properties": {
        "code": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rating",
        "label",
        "score",
        "moat",
        "gate_pass",
        "gate_reason"
      ],
      "properties": {
        "rating": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "moat": {
          "type": "string"
        },
        "gate_pass": {
          "type": "boolean"
        },
        "gate_reason": {
          "type": "string"
        }
      }
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "thesis",
        "confidence"
      ],
      "properties": {
        "verdict": {
          "$ref": "#/$defs/verdict"
        },
        "thesis": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "macro": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rf_cny",
        "rf_usd",
        "usd_cny",
        "hkd_cny",
        "as_of"
      ],
      "properties": {
        "rf_cny": {
          "type": "number"
        },
        "rf_usd": {
          "type": "number"
        },
        "usd_cny": {
          "type": "number"
        },
        "hkd_cny": {
          "type": "number"
        },
        "as_of": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market",
        "code",
        "currency",
        "price",
        "price_date",
        "fair_low",
        "fair_mid",
        "fair_high",
        "valuation",
        "safety_margin_pct",
        "certainty",
        "expected_return",
        "downside",
        "position",
        "verdict"
      ],
      "properties": {
        "market": {
          "$ref": "#/$defs/marketCode"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "$ref": "#/$defs/currency"
        },
        "price": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "price_date": {
          "type": "string",
          "format": "date"
        },
        "fair_low": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fair_mid": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fair_high": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "valuation": {
          "$ref": "#/$defs/valuation"
        },
        "etf_metrics": {
          "$ref": "#/$defs/etfMetrics"
        },
        "safety_margin_pct": {
          "type": "number"
        },
        "certainty": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "expected_return": {
          "$ref": "#/$defs/expectedReturn"
        },
        "downside": {
          "$ref": "#/$defs/downside"
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "verdict": {
          "$ref": "#/$defs/verdict"
        }
      }
    },
    "valuation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pe",
        "pb",
        "dividend_yield_after_tax",
        "percentile"
      ],
      "properties": {
        "pe": {
          "type": "number"
        },
        "pb": {
          "type": "number"
        },
        "dividend_yield_after_tax": {
          "type": "number"
        },
        "percentile": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "etfMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index_code",
        "index_name",
        "weight_method",
        "weight_as_of",
        "weight_source",
        "coverage_pct",
        "pb_as_of",
        "pb_source",
        "nav",
        "nav_date",
        "nav_source",
        "premium_discount_pct",
        "constituents",
        "representative_pb"
      ],
      "properties": {
        "index_code": {
          "type": "string",
          "minLength": 1
        },
        "index_name": {
          "type": "string",
          "minLength": 1
        },
        "weight_method": {
          "const": "top10_market_cap_weighted_harmonic"
        },
        "weight_as_of": {
          "type": "string",
          "format": "date"
        },
        "weight_source": {
          "type": "string",
          "minLength": 1
        },
        "coverage_pct": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "pb_as_of": {
          "type": "string",
          "format": "date"
        },
        "pb_source": {
          "type": "string",
          "minLength": 1
        },
        "nav": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "nav_date": {
          "type": "string",
          "format": "date"
        },
        "nav_source": {
          "type": "string",
          "minLength": 1
        },
        "premium_discount_pct": {
          "type": "number"
        },
        "constituents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/etfConstituent"
          }
        },
        "representative_pb": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "etfConstituent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "name",
        "weight_pct",
        "pb"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "weight_pct": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "pb": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "expectedReturn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dividend",
        "growth",
        "valuation",
        "fx",
        "total"
      ],
      "properties": {
        "dividend": {
          "type": "number"
        },
        "growth": {
          "type": "number"
        },
        "valuation": {
          "type": "number"
        },
        "fx": {
          "type": "number"
        },
        "total": {
          "type": "number"
        }
      }
    },
    "downside": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_drawdown_pct",
        "scenario"
      ],
      "properties": {
        "max_drawdown_pct": {
          "type": "number",
          "maximum": 0
        },
        "scenario": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tranches"
      ],
      "properties": {
        "tranches": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/positionTier"
          }
        }
      }
    },
    "positionTier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "price",
        "trigger_type",
        "condition",
        "allocation_pct",
        "active"
      ],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "price": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "trigger_type": {
          "enum": [
            "valuation",
            "evidence",
            "stabilization",
            "catalyst",
            "reserve"
          ]
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "allocation_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "active": {
          "type": "boolean"
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "sections"
      ],
      "properties": {
        "schema_version": {
          "const": "1.2"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      }
    },
    "sectionRole": {
      "enum": [
        "dashboard",
        "quality",
        "cycle",
        "model_analysis",
        "cross_market",
        "valuation",
        "position",
        "expected_return",
        "risks",
        "conclusion",
        "sources",
        "disclaimer"
      ]
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "title",
        "market",
        "blocks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "role": {
          "$ref": "#/$defs/sectionRole"
        },
        "module": {
          "$ref": "#/$defs/modelModule"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "market": {
          "enum": [
            "common",
            "A",
            "H",
            "US",
            "CN"
          ]
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      },
      "not": {
        "properties": {
          "title": {
            "pattern": "(A\\s*股|H\\s*股|A/H|AH)"
          }
        },
        "required": [
          "title"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "model_analysis"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "required": [
              "module"
            ]
          },
          "else": {
            "not": {
              "required": [
                "module"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "dashboard"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "blocks": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/gaugesBlock"
                    },
                    {
                      "properties": {
                        "items": {
                          "minItems": 4,
                          "maxItems": 4
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "cycle"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "blocks": {
                "prefixItems": [
                  {
                    "$ref": "#/$defs/industryLifecycleBlock"
                  }
                ],
                "contains": {
                  "$ref": "#/$defs/industryLifecycleBlock"
                },
                "minContains": 1,
                "maxContains": 1
              }
            }
          }
        }
      ]
    },
    "block": {
      "oneOf": [
        {
          "$ref": "#/$defs/headingBlock"
        },
        {
          "$ref": "#/$defs/paragraphBlock"
        },
        {
          "$ref": "#/$defs/calloutBlock"
        },
        {
          "$ref": "#/$defs/bulletsBlock"
        },
        {
          "$ref": "#/$defs/tableBlock"
        },
        {
          "$ref": "#/$defs/formulaBlock"
        },
        {
          "$ref": "#/$defs/industryLifecycleBlock"
        },
        {
          "$ref": "#/$defs/industryCycleBlock"
        },
        {
          "$ref": "#/$defs/gridBlock"
        },
        {
          "$ref": "#/$defs/scoresBlock"
        },
        {
          "$ref": "#/$defs/metricCardsBlock"
        },
        {
          "$ref": "#/$defs/gaugesBlock"
        },
        {
          "$ref": "#/$defs/valuationScenariosBlock"
        },
        {
          "$ref": "#/$defs/rangePositionBlock"
        },
        {
          "$ref": "#/$defs/positionTiersBlock"
        },
        {
          "$ref": "#/$defs/returnStackBlock"
        },
        {
          "$ref": "#/$defs/premiumDonutBlock"
        },
        {
          "$ref": "#/$defs/riskCardsBlock"
        }
      ]
    },
    "blockMarket": {
      "enum": [
        "A",
        "H",
        "US",
        "CN"
      ]
    },
    "headingBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "level",
        "text"
      ],
      "properties": {
        "type": {
          "const": "heading"
        },
        "level": {
          "enum": [
            2,
            3,
            4
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "paragraphBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "paragraph"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "boolean"
        }
      }
    },
    "calloutBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "tone",
        "title",
        "body"
      ],
      "properties": {
        "type": {
          "const": "callout"
        },
        "tone": {
          "enum": [
            "pos",
            "warn",
            "neg",
            "info"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "boolean"
        }
      }
    },
    "bulletsBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "items"
      ],
      "properties": {
        "type": {
          "const": "bullets"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tableColumnRole": {
      "enum": [
        "label",
        "value",
        "assessment",
        "action",
        "note",
        "date",
        "metric",
        "scenario",
        "unit",
        "status"
      ]
    },
    "tableBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "variant",
        "columns",
        "rows"
      ],
      "properties": {
        "type": {
          "const": "table"
        },
        "variant": {
          "enum": [
            "comparison",
            "matrix",
            "checklist"
          ]
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/tableColumn"
          }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": [
                "string",
                "number"
              ]
            }
          }
        }
      }
    },
    "tableColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "role"
      ],
