APP_ENV=development

# 相对路径以启动进程的工作目录为准
DATABASE_URL=sqlite:///storage/app.db

# 可选的历史 JSON 数据导入目录。不存在时 bootstrap 会跳过导入。
LEGACY_DATA_DIR=../data
LEGACY_REPORTS_DIR=..
# LEGACY_COMMON_DIR=/absolute/path/to/common

# 调度与展示使用的默认时区
TIMEZONE=Asia/Shanghai

# Codex CLI 可执行文件名或绝对路径
CODEX_BINARY=codex
CODEX_TIMEOUT_SECONDS=1200
# CODEX_MODEL=
# 记录 Codex 启动上下文；启用 trace 时同时用 strace 记录文件与进程调用
CODEX_DEBUG=false
CODEX_TRACE=false

# 运行时数据目录
STORAGE_ROOT=storage
